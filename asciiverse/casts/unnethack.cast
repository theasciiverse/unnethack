[0.000, "o", "\u001b[H\u001b[2J\u001b[4;11H\u001b[H\u001b[2J\u001b[4;11H\u001b[6;72H\u001b[37m┌────┐\u001b[0m\u001b[7;72H\u001b[37m│···\u001b[4m·\u001b[24m\u001b[0m\u001b[0m\u001b[37m│\u001b[0m\u001b[8;72H\u001b[33m+\u001b[0m\u001b[37m··\u001b[0m\u001b[97m@\u001b[0m\u001b[37m·│\u001b[0m\u001b[9;72H\u001b[37m│·\u001b[0m\u001b[97m\u001b[7mf\u001b[0m\u001b[0m\u001b[37m··│\u001b[0m\u001b[10;72H\u001b[37m│····│\u001b[0m\u001b[11;72H\u001b[37m·····│\u001b[0m\u001b[12;72H\u001b[37m└───·┘\u001b[0m\u001b[8;75H"]
[0.003, "o", "\u001b[26;11H[\u001b[7m\u001b[26;11H\u001b[26;12HFreya the Stripling\u001b[0m\u001b[0m\u001b[26;11H\u001b[26;31H]       St:16 Dx:16 Co:18 In:7 Wi:8 Ch:9  Neutral\u001b[27;11HThe Dungeons of Doom:1  $:0  HP:\u001b[K\u001b[27;11H\u001b[27;43H16(16)\u001b[27;11H\u001b[27;49H Pw:\u001b[27;11H\u001b[27;53H2(2)\u001b[27;11H\u001b[27;57H AC:6  Exp:1 T:1\u001b[4;30H\u001b[K It is written in the Book of Odin:\u001b[5;30H\u001b[K \u001b[6;30H\u001b[K     After the Creation, the cruel god Moloch rebelled\u001b[7;30H\u001b[K     against the authority of Vishvakarman the Creator.\u001b[8;30H\u001b[K     Moloch stole from Vishvakarman the most powerful of all\u001b[9;30H\u001b[K     the artifacts of the gods, the Amulet of Yendor,\u001b[10;30H\u001b[K     and he hid it in the dark cavities of Gehennom, the\u001b[11;30H\u001b[K     Under World, where he now lurks, and bides his time.\u001b[12;30H\u001b[K \u001b[13;30H\u001b[K Your god Odin seeks to possess the Amulet, and with it\u001b[14;30H\u001b[K to gain deserved ascendance over the other gods.\u001b[15;30H\u001b[K \u001b[16;30H\u001b[K You, a newly trained Stripling, have been heralded\u001b[17;30H\u001b[K from birth as the instrument of Odin.  You are destined\u001b[18;30H\u001b[K to recover the Amulet for your deity, or die in the\u001b[19;30H\u001b[K attempt.  Your hour of destiny has come.  For the sake\u001b[20;30H\u001b[K of us all:  Go bravely with Odin!\u001b[21;30H\u001b[K\u001b[21;31H\u001b[7m--End--\u001b[27m"]
